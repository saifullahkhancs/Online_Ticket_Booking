# ---------------------------------------------------------------
# MongoDB connection
# ---------------------------------------------------------------
# If MONGO_URI is left empty, the server runs a zero-setup DEMO using an
# in-memory data store (no MongoDB install needed) and auto-seeds ~120 random
# world flights.
#
# To use a real MongoDB (production MERN), uncomment MONGO_URI and point it at
# your local MongoDB or Atlas connection string, for example:
#   mongodb://127.0.0.1:27017/world_flights
#   mongodb+srv://<user>:<pass>@cluster0.mongodb.net/world_flights
#
# When a real MongoDB is used, run `node seed.js` from /server to populate it
# with random world-flight data (or it auto-seeds once on first start).
# MONGO_URI=mongodb://127.0.0.1:27017/world_flights

# Set to true to force the in-memory demo store even when MONGO_URI is set.
# MONGO_MEMORY=false

# Port the Express API listens on.
PORT=5000
